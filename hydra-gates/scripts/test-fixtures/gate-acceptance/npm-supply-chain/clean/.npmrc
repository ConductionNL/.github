# The conformant state: a two-day window, the first-party exemption, and an
# engines.npm (in package.json) that admits only an npm implementing them.
#
# `legacy-peer-deps` is here on purpose. It is unrelated to the cooldown and 8
# apps in the fleet carry it; a gate that graded .npmrc as a whole rather than
# per-setting would go red on this line, and this arm is what catches that.
legacy-peer-deps=true

min-release-age=2
min-release-age-exclude[]=@conduction/*
