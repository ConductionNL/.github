 "beyond": [
  {
   "label": "PHP line coverage",
   "why": "SIG rates no tests. Coverage shows how much of the code a unit or integration test runs.",
   "basis": "Heitlager, Kuipers and Visser 2007: unit test coverage ++ 95-100%, + 80-95%, o 60-80%, - 20-60%, -- 0-20%"
  },
  {
   "label": "spec coverage (gate 16)",
   "why": "Share of in-scope methods that name the spec they implement, so a change can be traced to a requirement.",
   "basis": "our choice: Heitlager's coverage bands applied to traceability"
  },
  {
   "label": "e2e scenario coverage (gate 19)",
   "why": "Share of non-excluded spec scenarios a running Playwright test cites: the behaviour a user sees is proven.",
   "basis": "our choice: Heitlager's coverage bands applied to spec scenarios"
  },
  {
   "label": "test code ratio",
   "why": "SIG's own test volume figure (test LOC / production LOC), shown in Sigrid without stars.",
   "basis": "Sigrid: a 100% test code ratio is roughly 80% coverage, so Heitlager's 95/80/60/20% coverage bands become 120/100/75/25% test code"
  },
  {
   "label": "baselined findings per kLOC PHP",
   "why": "psalm, phpstan and phpmd baselines hide findings from the gates. Each entry is debt a reviewer no longer sees.",
   "basis": "our own bands; no published benchmark"
  },
  {
   "label": "suppressions per kLOC",
   "why": "Inline @psalm-suppress, @phpstan-ignore, @SuppressWarnings, phpcs:ignore and eslint-disable silence a tool where SIG still counts the code.",
   "basis": "our own bands; no published benchmark"
  },
  {
   "label": "security gate findings",
   "why": "Gates 5-9, 11, 30, 48, 50, 82, 97 and 121 find missing auth, IDOR and fail-open checks that SAST tools do not know about Nextcloud.",
   "basis": "our own bands; 0 is the only passing state of each gate"
  },
  {
   "label": "vulnerable dependencies, high or critical",
   "why": "composer audit and npm audit on the lockfiles; SIG rates the same CVEs in Open Source Health.",
   "basis": "SIG Open Source Health: 4 stars means no vulnerability above moderate; 5 stars also no moderate"
  },
  {
   "label": "unmanaged dependencies",
   "why": "Third-party code committed into the repository (minified or vendored files) gets no security updates.",
   "basis": "SIG Open Source Health: 4 stars at most 6% unmanaged; 3 and 2 stars double that"
  },
  {
   "label": "accessibility findings per .vue file",
   "why": "SIG has no accessibility model. Gates 12 and 31-45 check WCAG 2.2 AA rules in the source.",
   "basis": "our own bands; WCAG 2.2 AA asks for none"
  },
  {
   "label": "UI convention findings",
   "why": "The UI gates keep every app on the shared nextcloud-vue patterns, so users meet one interface.",
   "basis": "our own bands; 0 is the only passing state of each gate"
  }
 ],
